# LLM API key (required for /generate and /query endpoints)
OPENAI_API_KEY=sk-...

# OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Port for the HTTP server (default: 3000)
PORT=3000

# SQLite database file path (default: ./parties.db)
DB_PATH=./parties.db

# Max LLM calls per IP per 15 minutes (default: 20)
LLM_RATE_LIMIT=20
